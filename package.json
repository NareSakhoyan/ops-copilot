{
  "name": "ops-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts | pino-pretty --colorize --translateTime=SYS:standard --ignore=pid,hostname",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/run.ts",
    "embed:check": "tsx scripts/embed-check.ts",
    "kb:ingest": "tsx src/rag/ingest.ts"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --fix"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/google-vertex": "^5.0.121",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@fastify/rate-limit": "^11.2.1",
    "ai": "^7.0.150",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "pgsql-ast-parser": "^12.0.2",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
