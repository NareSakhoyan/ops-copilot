NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

POSTGRES_DB=ops_copilot
POSTGRES_PORT=5432
POSTGRES_PASSWORD=local-development-only
MIGRATION_DATABASE_URL=postgresql://migration_owner:local-development-only@127.0.0.1:5432/ops_copilot
DATABASE_URL=postgresql://app_user:local-app-development-only@127.0.0.1:5432/ops_copilot

# Generate a secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=ops-copilot
JWT_AUDIENCE=ops-copilot-api

# AI Studio key; never commit a real value.
GOOGLE_GENERATIVE_AI_API_KEY=
EMBED_MODEL=gemini-embedding-001
# Fixed in the generated migration. Changing this requires a new migration/re-ingestion.
EMBED_DIM=1536
# REQUIRED: enter your project's actual embedding limits from Google AI Studio.
EMBED_RPM=
EMBED_RPD=
EMBED_TPM=
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:26b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Optional cloud providers: google uses the Google key above; gateway uses its own key.
AI_GATEWAY_API_KEY=
# With LLM_PROVIDER=gateway, LLM_MODEL may be a provider/model ID.
# With LLM_PROVIDER=vertex: no API key here. Auth comes from Application Default
# Credentials (an attached GCP service account, or GOOGLE_APPLICATION_CREDENTIALS
# set as a real process env var, never committed here).
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
# REQUIRED before answering: select from embed:check and representative KB evaluation.
KB_REFUSAL_THRESHOLD=

# OpenTelemetry: traces/metrics export to the Jaeger service in docker-compose.yml by default.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=ops-copilot
# Optional: per-model USD price per million tokens, e.g. {"gemini-3-flash-preview":{"promptPerMillion":0.1,"completionPerMillion":0.4}}.
# Unpriced/unset models report cost_usd=0 rather than guessing.
LLM_PRICE_TABLE_JSON=
